  },
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "symbols": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Symbols"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "cash": {
            "type": "number",
            "title": "Cash"
          },
          "fee": {
            "type": "number",
            "title": "Fee"
          },
          "slippage": {
            "type": "number",
            "title": "Slippage"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "return": {
            "type": "number",
            "title": "Return"
          },
          "benchmark_return": {
            "type": "number",
            "title": "Benchmark Return"
          },
          "days": {
            "type": "integer",
            "title": "Days"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/Position"
            },
            "type": "array",
            "title": "Positions"
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/PendingOrder"
            },
            "type": "array",
            "title": "Pending"
          },
          "fills": {
            "items": {
              "$ref": "#/components/schemas/Fill"
            },
            "type": "array",
            "title": "Fills"
          },
          "equity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquitySeries"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "strategy",
          "params",
          "symbols",
          "start",
          "cash",
          "fee",
          "slippage",
          "value",
          "return",
          "benchmark_return",
          "days",
          "positions",
          "pending",
          "fills"
        ],
        "title": "Account"
      },
      "AccountCreate": {
        "properties": {
          "cash": {
            "type": "number",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Cash",
            "description": "初始资金（美元）",
            "default": 10000
          },
          "fee": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Fee",
            "description": "每笔手续费（美元）",
            "default": 0
          },
          "slippage": {
            "type": "number",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Slippage",
            "description": "滑点（基点）",
            "default": 5
          },
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "核心"
            ]
          },
          "symbols": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Symbols",
            "examples": [
              [
                "QQQM",
                "VOO"
              ]
            ]
          },
          "fast": {
            "type": "integer",
            "maximum": 400.0,
            "minimum": 2.0,
            "title": "Fast",
            "default": 50
          },
          "slow": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 3.0,
            "title": "Slow",
            "default": 200
          }
        },
        "type": "object",
        "required": [
          "name",
          "symbols"
        ],
        "title": "AccountCreate"
      },
      "BacktestRequest": {
        "properties": {
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "rf": {
            "type": "number",
            "maximum": 0.5,
            "minimum": -0.1,
            "title": "Rf",
            "description": "无风险年利率，用于夏普比率",
            "default": 0
          },
          "refresh": {
            "type": "boolean",
            "title": "Refresh",
            "default": false
          },
          "cash": {
            "type": "number",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Cash",
            "description": "初始资金（美元）",
            "default": 10000
          },
          "fee": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Fee",
            "description": "每笔手续费（美元）",
            "default": 0
          },
          "slippage": {
            "type": "number",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Slippage",
            "description": "滑点（基点）",
            "default": 5
          },
          "symbol": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Symbol",
            "examples": [
              "QQQM"
            ]
          },
          "fast": {
            "type": "integer",
            "maximum": 400.0,
            "minimum": 2.0,
            "title": "Fast",
            "default": 50
          },
          "slow": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 3.0,
            "title": "Slow",
            "default": 200
          }
        },
        "type": "object",
        "required": [
          "symbol"
        ],
        "title": "BacktestRequest"
      },
      "BacktestResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "fast": {
            "type": "integer",
            "title": "Fast"
          },
          "slow": {
            "type": "integer",
            "title": "Slow"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "benchmark": {
            "$ref": "#/components/schemas/Summary"
          },
          "series": {
            "$ref": "#/components/schemas/BacktestSeries"
          },
          "trades": {
            "items": {
              "$ref": "#/components/schemas/Trade"
            },
            "type": "array",
            "title": "Trades"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "fast",
          "slow",
          "summary",
          "benchmark",
          "series",
          "trades"
        ],
        "title": "BacktestResponse"
      },
      "BacktestSeries": {
        "properties": {
          "dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Dates"
          },
          "close": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Close"
          },
          "fast": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Fast"
          },
          "slow": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Slow"
          },
          "equity": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Equity"
          },
          "benchmark": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Benchmark"
          }
        },
        "type": "object",
        "required": [
          "dates",
          "close",
          "fast",
          "slow",
          "equity",
          "benchmark"
        ],
        "title": "BacktestSeries",
        "description": "Columns of equal length, one value per trading day."
      },
      "Bars": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Dates"
          },
          "open": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Open"
          },
          "high": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "High"
          },
          "low": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Low"
          },
          "close": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Close"
          },
          "volume": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "dates",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "Bars"
      },
      "EquitySeries": {
        "properties": {
          "dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Dates"
          },
          "strategy": {
            "items": {
              "type": "number"
            },
            "type": "array",
