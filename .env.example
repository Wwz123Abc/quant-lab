# Copy to .env and change what you need. Every setting is optional.

# Where the SQLite databases (price cache, paper accounts) and the API token are kept
QUANTLAB_DATA_DIR=data
# Where the command line writes charts and CSV files
QUANTLAB_REPORTS_DIR=reports

# The API listens on this machine only. Use 0.0.0.0 only behind a firewall or a reverse proxy with HTTPS.
QUANTLAB_HOST=127.0.0.1
QUANTLAB_PORT=8000

# Leave unset to generate one on first start (kept in data/api_token). Never commit a real token.
# QUANTLAB_API_TOKEN=

# Allowed browser origins for cross-origin calls, e.g. the Vite dev server when not using its proxy
# QUANTLAB_CORS_ORIGINS=["http://localhost:5173"]

QUANTLAB_LOG_LEVEL=INFO
# text for people, json for log collectors
QUANTLAB_LOG_FORMAT=text

# Seconds before a cached symbol is downloaded again
QUANTLAB_CACHE_MAX_AGE=21600
QUANTLAB_HTTP_TIMEOUT=20

# ---------------------------------------------------------------- AI research (pip install -e ".[ai]")
# Provider keys are read only from the environment or this file; they are never stored anywhere else.
DEEPSEEK_API_KEY=
# Optional data sources used by TradingAgents' analysts
FRED_API_KEY=
# SEC asks for a contact in the User-Agent of EDGAR requests, e.g. "Your Name your@email"
SEC_EDGAR_USER_AGENT=

QUANTLAB_AI_PROVIDER=deepseek
QUANTLAB_AI_QUICK_MODEL=deepseek-flash
QUANTLAB_AI_DEEP_MODEL=deepseek-flash
QUANTLAB_AI_LANGUAGE=Chinese
# Hard monthly limit in CNY, and the USD/CNY rate used to convert provider prices
QUANTLAB_AI_BUDGET_CNY=100
QUANTLAB_AI_USD_CNY=7.3

# Daily job inside `quantlab serve`: Beijing time, Tuesday to Saturday
QUANTLAB_SCHEDULE_ENABLED=true
QUANTLAB_SCHEDULE_TIME=07:30

# ---------------------------------------------------------------- your real holdings
# Read-only key from the ledger's account page (it can only read trades, Treasuries/deposits and cash)
LEDGER_TOKEN=
QUANTLAB_LEDGER_URL=https://stock.wwz.cool
